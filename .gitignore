# ============================================================
# Karamchari .gitignore
# ============================================================

# .NET / Visual Studio
[Bb]in/
[Oo]bj/
[Oo]ut/
[Ll]og/
[Ll]ogs/
artifacts/
*.user
*.suo
*.userosscache
*.sln.docstates
*.userprefs
.vs/
.vscode/
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.tmp
*.cache
TestResults/
[Cc]overage*/

# NuGet
*.nupkg
*.snupkg
*.nuget.props
*.nuget.targets

# Rider
.idea/

# Node / Nx (frontend)
node_modules/
.next/
dist/
build/
.nx/
.cache/
coverage/
*.tsbuildinfo
.env
.env.local
.env.*.local

# OS
.DS_Store
Thumbs.db

# Secrets — never commit
secrets.json
*.pfx
*.snk
appsettings.*.Development.json
appsettings.*.Local.json
.user.secrets

# Build artifacts and scratch output files
build_results*.txt
test_results*.txt
*.log

# Claude Code / session artifacts — bash output fragments accidentally written
# to files when a pipe or redirect is malformed (e.g. grep output landing in
# a file named after a code token).
.claude/
