# ============================================================
# Karamchari .gitattributes
# Normalizes line endings and binary handling across Win/macOS/Linux contributors.
# ============================================================

# Default: text files normalized to LF in the repo, native EOL on checkout.
* text=auto eol=lf

# Windows-only file types — keep CRLF on disk (Visual Studio prefers it).
*.sln       text eol=crlf
*.csproj    text eol=crlf
*.props     text eol=crlf
*.targets   text eol=crlf
*.cmd       text eol=crlf
*.bat       text eol=crlf
*.ps1       text eol=crlf

# Always LF — required for cross-platform shell, configs, container build.
*.sh        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
Dockerfile  text eol=lf

# Source code — keep LF for consistent diffs.
*.cs        text eol=lf diff=csharp
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.sql       text eol=lf

# Binary types — git should NEVER attempt EOL conversion.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.pdf       binary
*.zip       binary
*.gz        binary
*.dll       binary
*.exe       binary
*.pfx       binary
*.snk       binary

# Help GitHub render diffs nicely for these.
*.md        linguist-detectable=true
*.sql       linguist-detectable=true
