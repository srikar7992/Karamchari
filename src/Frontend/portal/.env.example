# ============================================================
# Karamchari portal — environment variables.
# Copy to .env.local for local dev. Never commit .env.local.
# ============================================================

# Base URL of the .NET BFF. No trailing slash.
NEXT_PUBLIC_API_BASE_URL=http://localhost:60463

# Default tenant id sent on every API request via X-Tenant-Id.
# This is a DEV-ONLY default — production MUST resolve tenant from the user's
# JWT, not from a frontend env var.
# The local-dev seed creates a single tenant whose id is "dev" (referenced as
# the admin@dev.local user's tenant).
NEXT_PUBLIC_DEFAULT_TENANT_ID=dev

# Gateway proof header value — must match Tenancy.TrustedGatewayFingerprint
# in the API's appsettings.Development.json. Without it, DevelopmentTenantAuthenticationHandler
# will reject the request and HttpTenantProvider will refuse the X-Tenant-Id header.
# In production, this header is injected by APIM and never lives in a frontend env.
NEXT_PUBLIC_GATEWAY_FINGERPRINT=local-dev-gateway

# Dev-only bearer JWT. In production this env var is unset; the SPA never stores
# a bearer (tokens come from APIM or a cookie). To get a fresh dev token run:
#   POST http://localhost:60463/api/identity/login
#   Body: {"email":"admin@dev.local","password":"Dev@Pass123!"}
#   Header: X-Karamchari-Gateway: local-dev-gateway
# Copy the `accessToken` value from the response here. Tokens expire in 1 hour,
# so refresh before each local session.
NEXT_PUBLIC_DEV_BEARER_TOKEN=
