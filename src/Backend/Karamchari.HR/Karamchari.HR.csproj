<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Karamchari.HR — HR bounded context (employees, positions, leave, ...).
    Owns its DbContext and EF entities. Other bounded contexts MUST NOT
    reference HR's DbContext or EF types directly; cross-context
    communication goes via integration events on the bus.
  -->

  <PropertyGroup>
    <RootNamespace>Karamchari.HR</RootNamespace>
    <AssemblyName>Karamchari.HR</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MassTransit.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />

    <ProjectReference Include="..\Karamchari.Core\Karamchari.Core.csproj" />
  </ItemGroup>

</Project>
