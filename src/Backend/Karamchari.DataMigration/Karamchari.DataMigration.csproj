<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Karamchari.DataMigration — Enterprise Data Migration bounded context.
    Provides generic infrastructure for bulk data import and export.
  -->

  <PropertyGroup>
    <RootNamespace>Karamchari.DataMigration</RootNamespace>
    <AssemblyName>Karamchari.DataMigration</AssemblyName>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS1591;CA1062</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MassTransit.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <!-- For file parsing (CSV) -->
    <PackageReference Include="CsvHelper" />
    <!-- Design-time only: allows `dotnet ef migrations add` -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Karamchari.Core\Karamchari.Core.csproj" />
    <ProjectReference Include="..\Karamchari.Core.Contracts\Karamchari.Core.Contracts.csproj" />
    <ProjectReference Include="..\Karamchari.DataMigration.Contracts\Karamchari.DataMigration.Contracts.csproj" />
    <ProjectReference Include="..\Karamchari.HR\Karamchari.HR.csproj" />
    <ProjectReference Include="..\Karamchari.TimeAttendance\Karamchari.TimeAttendance.csproj" />
    <ProjectReference Include="..\Karamchari.Payroll\Karamchari.Payroll.csproj" />
  </ItemGroup>

</Project>
