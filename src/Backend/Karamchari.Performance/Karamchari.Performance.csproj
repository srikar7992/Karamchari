<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Karamchari.Performance — Performance Management bounded context.
    Owns: Goals, OKRs, KPIs, Reviews, Feedback, Calibration, Promotion,
          Skills, Career Progression, Performance Analytics.

    IMPORTANT: Do NOT reference Karamchari.HR directly. Cross-context
    communication is via integration events on the bus only.

    NOTE: This is currently a single DbContext (PerformanceDbContext).
    See ADR-0007 for the planned split into Performance.Core / Performance.Reviews /
    Performance.Analytics / Performance.Career before year 2.
  -->

  <PropertyGroup>
    <RootNamespace>Karamchari.Performance</RootNamespace>
    <AssemblyName>Karamchari.Performance</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- CS1591: XML doc coverage in progress. CA1062: framework guarantees non-null on internal paths. -->
    <NoWarn>$(NoWarn);CS1591;CA1062</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MassTransit.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Karamchari.Core\Karamchari.Core.csproj" />
    <ProjectReference Include="..\Karamchari.Core.Contracts\Karamchari.Core.Contracts.csproj" />
    <ProjectReference Include="..\Karamchari.Performance.Contracts\Karamchari.Performance.Contracts.csproj" />
  </ItemGroup>

</Project>
