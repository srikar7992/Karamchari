{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },

  "Tenancy": {
    "JwtClaimType": "tenant_id",
    "TenantHeaderName": "X-Tenant-Id",
    "TrustedGatewayHeader": "X-Karamchari-Gateway",
    "TrustedGatewayFingerprint": "",
    "RequireSubdomainAgreement": true,
    "AppHostSuffixes": "karamchari.com"
  },

  "AllowedHosts": "*"
}
