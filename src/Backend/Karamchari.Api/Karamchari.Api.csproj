<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Karamchari.Api — the REST BFF host.
    The only project that references every bounded context: it composes them
    into a single deployable. Domain logic does NOT live here.
  -->

  <PropertyGroup>
    <RootNamespace>Karamchari.Api</RootNamespace>
    <AssemblyName>Karamchari.Api</AssemblyName>
    <UserSecretsId>karamchari-api-dev</UserSecretsId>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- CS1591: Program.cs types are composition-root helpers, not a public library surface. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AspNetCore.HealthChecks.AzureServiceBus" />
    <PackageReference Include="AspNetCore.HealthChecks.SqlServer" />
    <PackageReference Include="FluentValidation.AspNetCore" />
    <PackageReference Include="MassTransit" />
    <PackageReference Include="MassTransit.Azure.ServiceBus.Core" />
    <PackageReference Include="MassTransit.EntityFrameworkCore" />
    <PackageReference Include="MassTransit.RabbitMQ" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
    <!-- Required by `dotnet ef` CLI tooling (design-time only; not bundled in publish output). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.Extensions.Http.Polly" />
    <!-- OpenTelemetry -->
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Enrichers.Environment" />
    <PackageReference Include="Serilog.Enrichers.Process" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.OpenTelemetry" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Karamchari.Core\Karamchari.Core.csproj" />
    <ProjectReference Include="..\Karamchari.Core.Contracts\Karamchari.Core.Contracts.csproj" />
    <ProjectReference Include="..\Karamchari.HR\Karamchari.HR.csproj" />
    <ProjectReference Include="..\Karamchari.Payroll\Karamchari.Payroll.csproj" />
    <ProjectReference Include="..\Karamchari.TimeAttendance\Karamchari.TimeAttendance.csproj" />
    <ProjectReference Include="..\Karamchari.PSA\Karamchari.PSA.csproj" />
    <ProjectReference Include="..\Karamchari.Billing\Karamchari.Billing.csproj" />
    <ProjectReference Include="..\Karamchari.Forecasting\Karamchari.Forecasting.csproj" />
    <ProjectReference Include="..\Karamchari.Workflow\Karamchari.Workflow.csproj" />
    <ProjectReference Include="..\Karamchari.Performance\Karamchari.Performance.csproj" />
    <ProjectReference Include="..\Karamchari.Notifications\Karamchari.Notifications.csproj" />
    <ProjectReference Include="..\Karamchari.Compensation\Karamchari.Compensation.csproj" />
    <ProjectReference Include="..\Karamchari.Identity.Infrastructure\Karamchari.Identity.Infrastructure.csproj" />
    <ProjectReference Include="..\Karamchari.Recruitment\Karamchari.Recruitment.csproj" />
    <ProjectReference Include="..\Karamchari.Capability\Karamchari.Capability.csproj" />
    <ProjectReference Include="..\Karamchari.Intelligence\Karamchari.Intelligence.csproj" />
    <ProjectReference Include="..\Karamchari.Governance\Karamchari.Governance.csproj" />
  </ItemGroup>

</Project>
