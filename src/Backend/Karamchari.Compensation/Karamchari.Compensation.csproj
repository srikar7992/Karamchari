<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Karamchari.Compensation — Compensation Planning bounded context.
    Owns: CompensationBand, SalaryRange, MeritMatrix, IncrementBudgetPool,
          EmployeeCompensationRecord.

    Phase 1 scope: bands, merit matrices, budget pools, compensation records.
    NOT in scope yet: payroll integration, actual payment processing.
    See ADR-0008 (compensation planning) when written.

    IMPORTANT: Do NOT reference Karamchari.HR, Karamchari.Payroll, or
    Karamchari.Performance directly. Cross-context via integration events only.
    Receives EmployeeCompensationRevisedIntegrationEvent from Compensation.Contracts.
  -->

  <PropertyGroup>
    <RootNamespace>Karamchari.Compensation</RootNamespace>
    <AssemblyName>Karamchari.Compensation</AssemblyName>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS1591;CA1062</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MassTransit.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Karamchari.Core\Karamchari.Core.csproj" />
    <ProjectReference Include="..\Karamchari.Core.Contracts\Karamchari.Core.Contracts.csproj" />
    <ProjectReference Include="..\Karamchari.Compensation.Contracts\Karamchari.Compensation.Contracts.csproj" />
  </ItemGroup>

</Project>
