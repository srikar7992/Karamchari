<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Karamchari.Notifications — Notification Orchestration bounded context.
    Owns: NotificationTemplate, UserNotificationPreference, NotificationMessage,
          NotificationDeliveryAttempt, DigestScheduler, RateLimitPolicy.

    Cross-context contract: all source BCs publish integration events to the bus.
    Notifications BC consumes them and owns all delivery orchestration.
    See ADR-0008 for the full notification platform design.

    IMPORTANT: Do NOT add delivery infrastructure (email SDK, push SDK) in this project.
    Channel adapters live in Karamchari.Api or dedicated adapter libraries.
    This BC owns the domain model and delivery scheduling only.
  -->

  <PropertyGroup>
    <RootNamespace>Karamchari.Notifications</RootNamespace>
    <AssemblyName>Karamchari.Notifications</AssemblyName>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS1591;CA1062</NoWarn>
  </PropertyGroup>

  <!-- SignalR Hub base class and IHubContext live in Microsoft.AspNetCore.App. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MassTransit.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Platform\Karamchari.Core\Karamchari.Core.csproj" />
    <ProjectReference Include="..\..\..\Platform\Karamchari.Core.Contracts\Karamchari.Core.Contracts.csproj" />
    <ProjectReference Include="..\..\Performance\Karamchari.Performance.Contracts\Karamchari.Performance.Contracts.csproj" />
    <ProjectReference Include="..\..\Payroll\Karamchari.Payroll.Contracts\Karamchari.Payroll.Contracts.csproj" />
  </ItemGroup>

</Project>
