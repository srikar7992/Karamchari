<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Karamchari.Forecasting</RootNamespace>
    <AssemblyName>Karamchari.Forecasting</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- CS1591: XML doc in progress. CA1062: framework guarantees non-null. CA1822: private helpers intentionally non-static. -->
    <NoWarn>$(NoWarn);CS1591;CA1062;CA1822</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Platform\Karamchari.Core\Karamchari.Core.csproj" />
    <ProjectReference Include="..\..\Billing\Karamchari.Billing.Contracts\Karamchari.Billing.Contracts.csproj" />
    <ProjectReference Include="..\..\TimeAttendance\Karamchari.TimeAttendance.Contracts\Karamchari.TimeAttendance.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MassTransit" />
    <PackageReference Include="MassTransit.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
