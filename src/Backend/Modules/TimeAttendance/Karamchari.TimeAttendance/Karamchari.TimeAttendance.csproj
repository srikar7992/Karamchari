<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\..\Platform\Karamchari.Core\Karamchari.Core.csproj" />
    <ProjectReference Include="..\..\..\Platform\Karamchari.Core.Contracts\Karamchari.Core.Contracts.csproj" />
    <ProjectReference Include="..\..\Billing\Karamchari.Billing.Contracts\Karamchari.Billing.Contracts.csproj" />
    <ProjectReference Include="..\Karamchari.TimeAttendance.Contracts\Karamchari.TimeAttendance.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MassTransit" />
    <PackageReference Include="MassTransit.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer.NetTopologySuite" />
    <!-- Design-time only: allows `dotnet ef migrations add` to discover TimeAttendanceDbContextDesignTimeFactory. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- CS1591: XML doc in progress. CA1062: MassTransit/EF framework guarantees non-null. CA1873: log-guard. -->
    <NoWarn>$(NoWarn);CS1591;CA1062;CA1873</NoWarn>
  </PropertyGroup>

</Project>
