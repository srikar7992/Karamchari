<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Karamchari.Onboarding — Onboarding bounded context.
    Owns: OnboardingCase, OnboardingTask, OnboardingDocument, OnboardingTemplate.

    Scope: NewHire pre-joining portal, crossboarding (transfers), offboarding checklists.
    Does NOT own: employee master data (HR), asset inventory (AssetManagement).
    Cross-context: fires OnboardingCaseCreated → Notifications, AssetManagement;
                   fires OnboardingCaseCompleted → HR (activate), Capability (assign learning).
  -->

  <PropertyGroup>
    <RootNamespace>Karamchari.Onboarding</RootNamespace>
    <AssemblyName>Karamchari.Onboarding</AssemblyName>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS1591;CA1062</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MassTransit.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Platform\Karamchari.Core\Karamchari.Core.csproj" />
    <ProjectReference Include="..\..\..\Platform\Karamchari.Core.Contracts\Karamchari.Core.Contracts.csproj" />
    <ProjectReference Include="..\Karamchari.Onboarding.Contracts\Karamchari.Onboarding.Contracts.csproj" />
  </ItemGroup>

</Project>
