<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Karamchari.Payroll — Payroll bounded context.
    Same isolation rules as HR: no cross-context EF/DbContext references.
  -->

  <PropertyGroup>
    <RootNamespace>Karamchari.Payroll</RootNamespace>
    <AssemblyName>Karamchari.Payroll</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Karamchari.Core\Karamchari.Core.csproj" />
    <ProjectReference Include="..\Karamchari.HR\Karamchari.HR.csproj" />
    <ProjectReference Include="..\Karamchari.TimeAttendance\Karamchari.TimeAttendance.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MassTransit" />
    <PackageReference Include="MassTransit.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="QuestPDF" />
    <PackageReference Include="Azure.AI.DocumentIntelligence" Version="1.0.0-beta.2" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.19.1" />
  </ItemGroup>
</Project>
