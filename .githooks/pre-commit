#!/bin/sh
# ==============================================================================
# Karamchari Enterprise Pre-Commit Hook
# Prevents broken builds, formatting violations, and secrets from entering the repo.
# ==============================================================================

echo "Running Karamchari Pre-Commit Checks..."

# 1. Check for staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.cs$')

if [ -z "$STAGED_FILES" ]; then
    echo "No C# files staged. Skipping .NET checks."
else
    echo "Staged C# files found. Running formatting and analyzers..."

    # 2. Enforce Formatting
    echo ">> Enforcing dotnet format..."
    dotnet format src/Backend/Karamchari.sln --verify-no-changes
    FORMAT_STATUS=$?
    if [ $FORMAT_STATUS -ne 0 ]; then
        echo "❌ Formatting check failed. Run 'dotnet format src/Backend/Karamchari.sln' to fix."
        exit 1
    fi

    # 3. Enforce Build & Analyzers
    echo ">> Verifying Build & Analyzers (Zero Warnings Policy)..."
    dotnet build src/Backend/Karamchari.sln -c Release -p:TreatWarningsAsErrors=true
    BUILD_STATUS=$?
    if [ $BUILD_STATUS -ne 0 ]; then
        echo "❌ Build or Analyzer checks failed. Fix warnings/errors before committing."
        exit 1
    fi
fi

# 4. Naive Secret Scanning (Example: looking for hardcoded 'Password=' or 'Secret=')
echo ">> Scanning for hardcoded secrets..."
SECRET_VIOLATIONS=$(git diff --cached -G"(?i)(password|secret|api[_-]?key)\s*[:=]\s*[\"'][^\"']+[\"']" --name-only)
if [ -n "$SECRET_VIOLATIONS" ]; then
    echo "❌ Potential hardcoded secrets found in the following files:"
    echo "$SECRET_VIOLATIONS"
    echo "Remove secrets and use user-secrets or environment variables."
    exit 1
fi

echo "✅ Pre-commit checks passed! Committing."
exit 0
