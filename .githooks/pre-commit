#!/bin/sh
# Karamchari enterprise pre-commit hook.
# Fast local gate: formatting, build/analyzers when backend files change, npm
# audits when lock files change, and staged secret scanning for every commit.

echo "Running Karamchari Pre-Commit Checks..."

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)
BACKEND_FILES=$(printf '%s\n' "$STAGED_FILES" | grep -E '(\.cs$|\.csproj$|\.props$|\.targets$|\.sln$|NuGet\.config$|global\.json$)' || true)
NPM_FILES=$(printf '%s\n' "$STAGED_FILES" | grep -E '(^src/Frontend/portal/package(-lock)?\.json$|^src/Mobile/karamchari-mobile/package(-lock)?\.json$)' || true)

if [ -n "$BACKEND_FILES" ]; then
    echo "Backend files changed. Running formatting and analyzers..."

    echo ">> Enforcing dotnet format..."
    dotnet format src/Backend/Karamchari.sln --verify-no-changes --severity warn --no-restore
    if [ $? -ne 0 ]; then
        echo "Formatting check failed. Run 'dotnet format src/Backend/Karamchari.sln' to fix."
        exit 1
    fi

    echo ">> Verifying build and analyzers (Zero Warnings Policy)..."
    dotnet build src/Backend/Karamchari.sln -c Release -warnaserror
    if [ $? -ne 0 ]; then
        echo "Build or analyzer checks failed. Fix warnings/errors before committing."
        exit 1
    fi
else
    echo "No backend build files staged. Skipping .NET build gate."
fi

if [ -n "$NPM_FILES" ]; then
    echo "Node dependency files changed. Running npm audits..."
    if [ -f src/Frontend/portal/package-lock.json ]; then
        npm audit --prefix src/Frontend/portal --audit-level=moderate || exit 1
    fi
    if [ -f src/Mobile/karamchari-mobile/package-lock.json ]; then
        npm audit --prefix src/Mobile/karamchari-mobile --audit-level=moderate || exit 1
    fi
fi

echo ">> Scanning for hardcoded secrets..."
# git diff -G uses POSIX ERE, which rejects PCRE inline flags like (?i); grep -i
# gives case-insensitivity instead. Scan added lines only; report files, not the
# matching lines, so secret values are never echoed.
SECRET_PATTERN='(password|secret|api[_-]?key|token|connectionstring|accountkey|sharedaccesskey)[[:space:]]*[:=][[:space:]]*["'\''][^"'\'']{8,}["'\'']'
SECRET_VIOLATIONS=""
for f in $STAGED_FILES; do
    if git diff --cached -U0 -- "$f" | grep -E '^\+' | grep -iqE "$SECRET_PATTERN"; then
        SECRET_VIOLATIONS="$SECRET_VIOLATIONS$f
"
    fi
done
if [ -n "$SECRET_VIOLATIONS" ]; then
    echo "Potential hardcoded secrets found in the following files:"
    printf '%s' "$SECRET_VIOLATIONS"
    echo "Remove secrets and use user-secrets or environment variables."
    exit 1
fi

echo "Pre-commit checks passed."
exit 0
