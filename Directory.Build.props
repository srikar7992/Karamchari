<Project>

  <!--
    ============================================================
    Karamchari — root MSBuild props.
    Applied to every csproj under this repo (including tests).
    ============================================================
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1848;NU1608</NoWarn>

    <!-- Static analysis on by default; tighten per-project as needed. -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>

    <!-- Deterministic builds make CI artifacts reproducible. -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true' OR '$(TF_BUILD)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Source-link & symbols for production debuggability. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- Common metadata. -->
    <Company>Karamchari</Company>
    <Authors>Karamchari</Authors>
    <Product>Karamchari Employee Management System</Product>
    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>

  <!--
    NuGet Audit suppressions.
    These advisories affect System.Security.Cryptography.Xml which is a transitive
    dependency of MassTransit.Azure.ServiceBus.Core. No fixed version is available
    from the upstream maintainer yet. Reviewed 2026-05-05 — the package is only used
    in the service bus transport layer (not in any user-input XML processing path).
    Remove suppressions once MassTransit ships a patched transport.
  -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-37gx-xxp4-5rgx" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-w3x6-4m5h-cxqf" />
    <!-- OpenTelemetry.Api 1.10.0 — no fixed version published yet for these advisories.
         Only affects internal telemetry pipeline; not user-input paths. Review on next OTel release. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-8785-wc3w-h8q6" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-g94r-2vxg-569j" />
  </ItemGroup>

  <!-- Centralized output paths to keep src/Backend tree clean. -->
  <PropertyGroup>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)artifacts\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory)artifacts\bin\$(MSBuildProjectName)\</BaseOutputPath>
  </PropertyGroup>

  <!-- Disable XML docs and analyzers for Test projects -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests')) or $(MSBuildProjectName.EndsWith('.IntegrationTests')) or $(MSBuildProjectName.EndsWith('.UnitTests'))">
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591;1587</NoWarn>
  </PropertyGroup>

</Project>
