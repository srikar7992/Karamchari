# Dev-only auto-login used by ensureDevSession() (src/lib/auth.ts).
# Copy this file to .env.local (gitignored) and fill in the documented seeded
# dev credentials from docs/audits/api-certification/AUTHENTICATION_GUIDE.md.
# Development environment only — never set real/production secrets here.
VITE_DEV_EMAIL=manager@dev.local
VITE_DEV_PASSWORD=

# Optional: override the BFF base URL (defaults to http://localhost:60463).
# VITE_API_BASE=http://localhost:60463
